# ── LLM / Enrichment provider ─────────────────────────────────────────────────
# LLM_PROVIDER selects which provider is used for dimension enrichment.
# Values: "groq" | "gemini" | "none"
# If unset, auto-detection runs: GROQ_API_KEY -> groq, GEMINI_API_KEY -> gemini, else noop.
LLM_PROVIDER=gemini

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq alternate enrichment model. Qwen 3.8 supports strict JSON Schema output.
GROQ_MODEL=qwen/qwen3.8-27b
# Authoritative candidate-evidence extraction uses an independently pinned model.
GROQ_CANDIDATE_EXTRACTION_MODEL=qwen/qwen3.8-27b

# Gemini enrichment. The Oracle proof/production route uses Vertex AI with ADC when
# GEMINI_API_KEY is unset; setting GEMINI_API_KEY selects the Gemini API-key transport.
# Default model is Gemini 3.5 Flash-Lite on the global Vertex endpoint.
# GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_ENRICHMENT_MODEL=gemini-3.5-flash-lite
GEMINI_ENRICHMENT_LOCATION=global
# Conservative RADAR traffic-smoothing policy; this is not a documented Vertex RPM quota.
GEMINI_MIN_START_INTERVAL_MS=4200
GEMINI_MAX_IN_FLIGHT=2
GEMINI_MAX_PROVIDER_RETRIES=2
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_ENRICHMENT_MAX_OUTPUT_TOKENS=1024

# Enrichment coverage mode: deterministic | smart | maximum (default: smart)
# - deterministic: never call LLM, regex-only
# - smart: call LLM for Core-importance dimensions that are Missing
# - maximum: call LLM for all Core + Supporting dimensions that are Missing
ENRICHMENT_MODE=smart

# ── Browser profile directories ───────────────────────────────────────────────
# LinkedIn persistent Chromium profile (must already be logged into LinkedIn).
# Defaults to ./scraper-profile at the project root.
LINKEDIN_PROFILE_DIR=./scraper-profile

# Base directory for other portal profiles (Indeed, Naukri, future portals).
# Defaults to .scraper-cache/profiles
SCRAPER_PROFILE_DIR=.scraper-cache/profiles

# ── Database Configuration ───────────────────────────────────────────────────
# Turso Cloud SQLite URL (e.g. libsql://your-db-name.turso.io)
TURSO_CONNECTION_URL=libsql://your-database-name.turso.io
# Turso Database Auth Token (generated via `turso db tokens create <db>`)
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Scraper artifact deployment mode ─────────────────────────────────────────
# Production must declare its topology explicitly. Use single_host when the
# scraper and enrichment worker share one durable host; use distributed only
# with remote object storage configured below.
RADAR_DEPLOYMENT_MODE=single_host

# Single-host artifact spool budget. Successful enrichment payloads are deleted
# after canonical persistence; failed payloads remain within these limits for
# diagnosis and retry.
RADAR_ARTIFACT_MAX_BYTES=536870912
RADAR_ARTIFACT_MAX_FILES=5000
RADAR_ARTIFACT_RETENTION_HOURS=168

# Required only when RADAR_DEPLOYMENT_MODE=distributed (S3/R2/MinIO compatible).
# BLOB_STORAGE_ENDPOINT=https://your-object-store.example
# BLOB_STORAGE_BUCKET=radar-snapshots

# ── Authentication & Session Security ─────────────────────────────────────────
# Session cookie encryption / signing secret
AUTH_SESSION_SECRET=your_long_random_session_secret_here

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/callback

# Staged intelligence and executive memo providers
# Bedrock API key CSV is a local secret and must remain outside Git.
BEDROCK_API_KEY_FILE=./bedrock-long-term-api-key.csv
TAVILY_API_KEY=your_tavily_api_key_here
# Gemini factual review uses Google ADC, not GEMINI_API_KEY.
GCP_PROJECT_ID=your-google-cloud-project
# Local: gcloud auth application-default login
# Production: attached service account or workload identity ADC.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/adc-configuration.json
