{
  "name": "radar-v2",
  "private": true,
  "engines": {
    "node": ">=22.22.2",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev:dossier": "tsx scripts/dossier/preview-staged.ts",
    "build:dossier": "vite build --config scripts/dossier/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx scripts/dev.ts",
    "dev:full": "tsx scripts/dev.ts --full",
    "benchmark": "npx @dotenvx/dotenvx run -- npx tsx scripts/qa-eval.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json .github/workflows/ci.yml ecosystem.config.cjs eslint.config.js vitest.certification.config.ts scripts/certify.ts scripts/certification/manifest.ts scripts/release scripts/deploy.ts scripts/db-status.ts scripts/migrate.ts src/data/database/adapter.ts src/data/database/index.ts src/data/database/sqlite.ts src/data/database/turso.ts src/data/sqlite/migrations/runner.ts src/lib/env.ts src/lib/health src/server.ts tests/certification/certification-gate-integrity.test.ts tests/persistence/migration-runner.test.ts tests/persistence/deployment-determinism.test.ts tests/release",
    "typecheck:scraper": "tsc -p tsconfig.scraper.json --noEmit",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:preflight": "tsx scripts/scraper/preflight.ts",
    "enrich": "tsx scripts/enrich.ts",
    "corpus:generate": "tsx scripts/corpus/pipeline.ts",
    "corpus:health": "tsx scripts/corpus/health.ts",
    "validate-graph": "tsx scripts/validate-graph.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:full": "vitest run --config vitest.full.config.ts",
    "certify": "tsx scripts/certify.ts",
    "certify:feedback": "tsx scripts/certify.ts --feedback",
    "certify:profile": "tsx scripts/certify.ts --profile",
    "certify:affected": "tsx scripts/certification/affected.ts",
    "certify:radar": "npm run certify",
    "smoke": "tsx --env-file=.env scripts/smoke_production.ts",
    "acceptance:operations": "tsx scripts/acceptance/browser-acceptance.ts --operations",
    "acceptance:browser": "tsx scripts/acceptance/browser-acceptance.ts",
    "diagnose": "tsx --env-file=.env scripts/diagnose.ts",
    "repair:canonical-urls": "tsx scripts/repair-canonical-apply-urls.ts",
    "test:eqe": "npm run certify",
    "db:reset-corpus": "tsx scripts/db/reset-corpus.ts --confirm",
    "deploy": "tsx scripts/deploy.ts",
    "release:package": "tsx scripts/release/package.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "reconcile:canonical-state": "node --import tsx scripts/reconcile-canonical-state.ts",
    "worker:documents": "tsx scripts/process-document-jobs.ts",
    "worker:scrape": "tsx scripts/run-scrape-worker.ts",
    "worker:corpus": "tsx scripts/run-corpus-regeneration-worker.ts",
    "worker:admin-bench": "tsx scripts/run-admin-bench-worker.ts",
    "verify:remote-turso-fk": "tsx scripts/verify-remote-turso-foreign-keys.ts",
    "verify:remote-admin-taxonomy": "tsx scripts/verify-remote-admin-taxonomy.ts",
    "worker:pursuit": "tsx scripts/run-pursuit-preparation-worker.ts",
    "worker:enrichment": "tsx scripts/enrich.ts",
    "worker:evaluations": "tsx scripts/run-evaluation-worker.ts",
    "worker:dossiers": "tsx scripts/run-dossier-composition-worker.ts",
    "worker:reviews": "tsx scripts/run-dossier-review-worker.ts",
    "storage:verify-oci": "tsx scripts/storage/verify-oci.ts",
    "storage:inventory": "tsx scripts/storage/migrate-blobs.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "arctic": "^1.9.2",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.0.0",
    "jsdom": "^30.0.1",
    "mammoth": "^1.12.0",
    "oci-common": "^2.142.1",
    "oci-objectstorage": "^2.142.1",
    "oslo": "^1.2.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "undici": "^8.7.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.30.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
